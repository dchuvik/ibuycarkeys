---
import Layout from "~/layouts/Layout.astro";
import Section from "~/components/Section.astro";
import Container from "~/components/Container.astro";
import { getAccountProfile, getAccountRole, getAccountUser } from "~/lib/accountAuth";
import { getSupabaseAdmin } from "~/lib/supabaseAdmin";
import { supabaseTables } from "~/lib/supabaseTables";

export const prerender = false;

const user = await getAccountUser(Astro.cookies, Astro.url.protocol === "https:");
if (!user?.email) {
	return Astro.redirect("/login/?returnTo=/account/");
}

const supabaseAdmin = getSupabaseAdmin();
const role = await getAccountRole(user.id);
const profile = await getAccountProfile(user.id);
const profileUpdated = Astro.url.searchParams.get("profile") === "updated";
const profileError = Astro.url.searchParams.get("profile") === "error";

const { data: unclaimedQuotes } = await supabaseAdmin
	.from(supabaseTables.quoteRequests)
	.select("id, customer_email")
	.is("user_id", null);
const matchingUnclaimedQuoteIds = (unclaimedQuotes ?? [])
	.filter((quote) => quote.customer_email.trim().toLowerCase() === user.email?.trim().toLowerCase())
	.map((quote) => quote.id);

if (matchingUnclaimedQuoteIds.length) {
	await supabaseAdmin
		.from(supabaseTables.quoteRequests)
		.update({ user_id: user.id })
		.in("id", matchingUnclaimedQuoteIds);
}

const { data: quotes, error } = await supabaseAdmin
	.from(supabaseTables.quoteRequests)
	.select("id, customer_name, total_keys, estimated_payout, status, created_at, quote_summary")
	.eq("user_id", user.id)
	.order("created_at", { ascending: false });

const formatDate = (value: string) =>
	new Intl.DateTimeFormat("en-US", { dateStyle: "medium", timeStyle: "short" }).format(new Date(value));

const statusClass = (status?: string | null) =>
	status === "approved"
		? "bg-emerald-100 text-emerald-800"
		: status === "rejected"
			? "bg-rose-100 text-rose-800"
			: "bg-amber-100 text-amber-800";
---

<Layout pageTitle="My quotes | I Buy Car Keys" title="My quotes" description="Track your submitted car key quotes." noindex={true}>
	<Section class:list={"bg-slate-50"}>
		<Container>
			<div class="mx-auto max-w-6xl space-y-7">
				<div class="flex flex-col gap-5 rounded-[2rem] bg-gray-950 p-7 text-white shadow-xl sm:flex-row sm:items-center sm:justify-between lg:p-9">
					<div>
						<p class="text-sm font-semibold uppercase tracking-[0.18em] text-sky-300">Your account</p>
						<h1 class="mt-3 text-4xl font-bold tracking-[-0.03em]">My quotes</h1>
						<p class="mt-2 text-sm text-slate-300">{user.email}</p>
					</div>
					<div class="flex flex-col gap-3 sm:flex-row">
						{role === "admin" && <a href="/admin/" class="button button-white min-h-11 rounded-full px-5 text-sm">Admin dashboard</a>}
						<a href="/#calculator" class="button button-yellow min-h-11 rounded-full px-5 text-sm">Start another quote</a>
						<form method="POST" action="/api/account-logout">
							<button type="submit" class="button button-white min-h-11 w-full rounded-full px-5 text-sm">Sign out</button>
						</form>
					</div>
				</div>

				<section class="rounded-[2rem] bg-white p-6 shadow-sm ring-1 ring-gray-200 lg:p-8">
					<div class="max-w-3xl">
						<p class="text-sm font-semibold uppercase tracking-[0.16em] text-sky-700">Account details</p>
						<h2 class="mt-2 text-2xl font-bold text-gray-950">Personal information</h2>
						<p class="mt-2 text-sm text-gray-600">These details will be used to prefill your future quote submissions.</p>
					</div>

					{profileUpdated && <p class="mt-5 rounded-2xl bg-emerald-50 p-4 text-sm font-medium text-emerald-800 ring-1 ring-emerald-200">Your information has been updated.</p>}
					{profileError && <p class="mt-5 rounded-2xl bg-red-50 p-4 text-sm font-medium text-red-700 ring-1 ring-red-200">Please check every field and try again.</p>}

					<form method="POST" action="/api/account-profile" class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2">
						<label class="block sm:col-span-2">
							<span class="text-sm font-semibold text-gray-800">Full name</span>
							<input name="fullName" type="text" autocomplete="name" required value={profile?.full_name ?? ""} class="mt-2 w-full rounded-xl border border-gray-300 px-4 py-3 text-gray-950" />
						</label>
						<label class="block">
							<span class="text-sm font-semibold text-gray-800">Email</span>
							<input type="email" value={user.email} disabled class="mt-2 w-full cursor-not-allowed rounded-xl border border-gray-200 bg-gray-100 px-4 py-3 text-gray-600" />
						</label>
						<label class="block">
							<span class="text-sm font-semibold text-gray-800">Phone number</span>
							<input name="phoneNumber" type="tel" autocomplete="tel" required value={profile?.phone_number ?? ""} class="mt-2 w-full rounded-xl border border-gray-300 px-4 py-3 text-gray-950" />
						</label>
						<label class="block sm:col-span-2">
							<span class="text-sm font-semibold text-gray-800">Mailing address</span>
							<input name="mailingAddress" type="text" autocomplete="street-address" required value={profile?.mailing_address ?? ""} class="mt-2 w-full rounded-xl border border-gray-300 px-4 py-3 text-gray-950" />
						</label>
						<label class="block">
							<span class="text-sm font-semibold text-gray-800">City</span>
							<input name="city" type="text" autocomplete="address-level2" required value={profile?.city ?? ""} class="mt-2 w-full rounded-xl border border-gray-300 px-4 py-3 text-gray-950" />
						</label>
						<div class="grid grid-cols-2 gap-4">
							<label class="block">
								<span class="text-sm font-semibold text-gray-800">State</span>
								<input name="state" type="text" autocomplete="address-level1" required maxlength="2" value={profile?.state ?? ""} class="mt-2 w-full rounded-xl border border-gray-300 px-4 py-3 uppercase text-gray-950" />
							</label>
							<label class="block">
								<span class="text-sm font-semibold text-gray-800">ZIP code</span>
								<input name="zipCode" type="text" inputmode="numeric" autocomplete="postal-code" required pattern="[0-9]{5}" maxlength="5" value={profile?.zip_code ?? ""} class="mt-2 w-full rounded-xl border border-gray-300 px-4 py-3 text-gray-950" />
							</label>
						</div>
						<div class="sm:col-span-2">
							<button type="submit" class="button button-black min-h-12 rounded-full px-7">Save changes</button>
						</div>
					</form>
				</section>

				{error && <p class="rounded-2xl bg-red-50 p-5 text-sm text-red-700 ring-1 ring-red-200">Your quotes could not be loaded.</p>}

				<div class="grid grid-cols-1 gap-5">
					{quotes?.length ? (
						quotes.map((quote) => (
							<article class="rounded-[2rem] bg-white p-6 shadow-sm ring-1 ring-gray-200">
								<div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
									<div>
										<div class="flex flex-wrap items-center gap-3">
											<h2 class="text-xl font-bold text-gray-950">Quote #{quote.id.slice(0, 8)}</h2>
											<span class={`rounded-full px-3 py-1 text-xs font-bold uppercase tracking-[0.1em] ${statusClass(quote.status)}`}>
												{quote.status ?? "new"}
											</span>
										</div>
										<p class="mt-2 text-sm text-gray-500">Submitted {formatDate(quote.created_at)}</p>
									</div>
									<div class="grid grid-cols-2 gap-3 sm:min-w-64">
										<div class="rounded-2xl bg-slate-50 p-4">
											<p class="text-xs font-bold uppercase tracking-wider text-gray-500">Keys</p>
											<p class="mt-2 text-2xl font-bold text-gray-950">{quote.total_keys ?? "—"}</p>
										</div>
										<div class="rounded-2xl bg-slate-50 p-4">
											<p class="text-xs font-bold uppercase tracking-wider text-gray-500">Estimate</p>
											<p class="mt-2 text-2xl font-bold text-sky-700">{quote.estimated_payout ?? "Pending"}</p>
										</div>
									</div>
								</div>
								<details class="mt-5 rounded-2xl bg-slate-50 p-4 ring-1 ring-slate-200">
									<summary class="cursor-pointer text-sm font-bold text-gray-900">View submitted quote</summary>
									<pre class="mt-4 whitespace-pre-wrap text-sm leading-6 text-gray-700">{quote.quote_summary}</pre>
								</details>
							</article>
						))
					) : (
						<div class="rounded-[2rem] bg-white px-6 py-14 text-center shadow-sm ring-1 ring-gray-200">
							<h2 class="text-2xl font-bold text-gray-950">No quotes yet</h2>
							<p class="mt-3 text-gray-600">Submit your first quote and it will appear here automatically.</p>
							<a href="/#calculator" class="button button-black mt-6 min-h-12 rounded-full px-6">Start a quote</a>
						</div>
					)}
				</div>
			</div>
		</Container>
	</Section>
</Layout>
