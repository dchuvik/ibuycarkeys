---
import Layout from "~/layouts/Layout.astro";
import Section from "~/components/Section.astro";
import Container from "~/components/Container.astro";
import { getAccountUser } from "~/lib/accountAuth";

export const prerender = false;

if (await getAccountUser(Astro.cookies, Astro.url.protocol === "https:")) {
	return Astro.redirect("/account/");
}

const error = Astro.url.searchParams.get("error");
---

<Layout pageTitle="Create account | I Buy Car Keys" title="Create account" description="Create an account to track your car key quotes." noindex={true}>
	<Section class:list={"bg-gradient-to-br from-slate-100 via-white to-sky-50"}>
		<Container>
			<div class="mx-auto max-w-lg rounded-[2rem] bg-white p-7 shadow-xl ring-1 ring-gray-200 sm:p-10">
				<p class="text-sm font-semibold uppercase tracking-[0.18em] text-sky-700">Quote tracking</p>
				<h1 class="mt-3 text-4xl font-bold tracking-[-0.03em] text-gray-950">Create your account</h1>
				<p class="mt-3 text-base text-gray-600">Keep all of your quote submissions and status updates in one place.</p>

				{error && (
					<p class="mt-6 rounded-2xl bg-red-50 px-4 py-3 text-sm text-red-700 ring-1 ring-red-200">
						{error === "exists" ? "An account already exists for this email." : "We could not create the account. Check the fields and try again."}
					</p>
				)}

				<form method="POST" action="/api/account-register" class="mt-7 space-y-5">
					<div>
						<label for="register-name">Full name</label>
						<input id="register-name" name="fullName" type="text" autocomplete="name" required />
					</div>
					<div>
						<label for="register-email">Email address</label>
						<input id="register-email" name="email" type="email" autocomplete="email" required />
					</div>
					<div>
						<label for="register-password">Password</label>
						<input id="register-password" name="password" type="password" autocomplete="new-password" minlength="8" required />
						<p class="mt-2 text-sm text-gray-500">Use at least 8 characters.</p>
					</div>
					<button type="submit" class="button button-black min-h-12 w-full rounded-full px-6">Create account</button>
				</form>

				<p class="mt-6 text-center text-sm text-gray-600">
					Already registered? <a href="/login/" class="font-bold text-gray-950 underline underline-offset-4">Sign in</a>
				</p>
			</div>
		</Container>
	</Section>
</Layout>

