<script>
	document.addEventListener("astro:page-load", () => {
		const adminTabs = Array.from(document.querySelectorAll("[data-admin-tab]"));
		const adminPanels = Array.from(document.querySelectorAll("[data-admin-panel]"));
		const validAdminTabs = new Set(adminTabs.map((tab) => tab.getAttribute("data-admin-tab")));

		const activateAdminTab = (tabName, { focus = false, updateHash = true } = {}) => {
			if (!tabName || !validAdminTabs.has(tabName)) {
				return;
			}

			for (const tab of adminTabs) {
				if (!(tab instanceof HTMLButtonElement)) {
					continue;
				}

				const isActive = tab.dataset.adminTab === tabName;
				tab.setAttribute("aria-selected", String(isActive));
				tab.tabIndex = isActive ? 0 : -1;
				tab.classList.toggle("bg-white", isActive);
				tab.classList.toggle("text-gray-950", isActive);
				tab.classList.toggle("shadow-sm", isActive);
				tab.classList.toggle("text-gray-300", !isActive);

				const count = tab.querySelector("span");
				count?.classList.toggle("bg-gray-100", isActive);
				count?.classList.toggle("text-gray-600", isActive);
				count?.classList.toggle("bg-white/10", !isActive);

				if (isActive && focus) {
					tab.focus();
				}
			}

			for (const panel of adminPanels) {
				if (panel instanceof HTMLElement) {
					panel.hidden = panel.dataset.adminPanel !== tabName;
				}
			}

			if (updateHash) {
				history.replaceState(null, "", `#${tabName}`);
			}
		};

		for (const [index, tab] of adminTabs.entries()) {
			if (!(tab instanceof HTMLButtonElement)) {
				continue;
			}

			tab.addEventListener("click", () => activateAdminTab(tab.dataset.adminTab));
			tab.addEventListener("keydown", (event) => {
				if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) {
					return;
				}

				event.preventDefault();
				const nextIndex =
					event.key === "Home"
						? 0
						: event.key === "End"
							? adminTabs.length - 1
							: (index + (event.key === "ArrowRight" ? 1 : -1) + adminTabs.length) % adminTabs.length;
				const nextTab = adminTabs[nextIndex];
				if (nextTab instanceof HTMLButtonElement) {
					activateAdminTab(nextTab.dataset.adminTab, { focus: true });
				}
			});
		}

		const requestedAdminTab = window.location.hash.slice(1);
		activateAdminTab(validAdminTabs.has(requestedAdminTab) ? requestedAdminTab : "quotes", { updateHash: false });

		const quoteActionStatus = document.getElementById("quote-action-status");
		const emailDraftPanel = document.getElementById("email-draft-panel");
		const emailDraftTo = document.getElementById("email-draft-to");
		const emailDraftSubject = document.getElementById("email-draft-subject");
		const emailDraftBody = document.getElementById("email-draft-body");
		const emailDraftStatus = document.getElementById("email-draft-status");
		const emailDraftSend = document.getElementById("email-draft-send");

		const showQuoteActionStatus = (message, tone = "info") => {
			if (!(quoteActionStatus instanceof HTMLElement)) {
				return;
			}

			quoteActionStatus.textContent = message;
			quoteActionStatus.classList.remove("hidden", "bg-slate-100", "text-slate-800", "ring-slate-200", "bg-red-50", "text-red-700", "ring-red-200");
			quoteActionStatus.classList.add(
				...(tone === "error"
					? ["bg-red-50", "text-red-700", "ring-red-200"]
					: ["bg-slate-100", "text-slate-800", "ring-slate-200"])
			);
		};

		const searchInput = document.getElementById("quote-search");
		const stateFilter = document.getElementById("quote-state-filter");
		const payoutFilter = document.getElementById("quote-payout-filter");
		const quoteResultsCount = document.getElementById("quote-results-count");
		const quoteEmptyState = document.getElementById("quote-table-empty");
		const quoteRows = Array.from(document.querySelectorAll("[data-quote-row]"));
		const approveButtons = Array.from(document.querySelectorAll("[data-approve-quote]"));
		const rejectButtons = Array.from(document.querySelectorAll("[data-reject-quote]"));
		const markNewButtons = Array.from(document.querySelectorAll("[data-mark-new-quote]"));
		const replyContactButtons = Array.from(document.querySelectorAll("[data-reply-contact]"));
		const markNewContactButtons = Array.from(document.querySelectorAll("[data-mark-new-contact]"));
		const contactRows = Array.from(document.querySelectorAll("[data-contact-row]"));
		const emailDraftClose = document.getElementById("email-draft-close");
		const emailDraftCloseButton = document.getElementById("email-draft-close-button");
		const emailDraftCopy = document.getElementById("email-draft-copy");
		const newKeyPanel = document.getElementById("new-key-panel");
		const newKeyClose = document.getElementById("new-key-close");
		const newKeyCloseButton = document.getElementById("new-key-close-button");
		const openNewKeyPanelButton = document.getElementById("open-new-key-panel");
		const statusFilter = document.getElementById("quote-status-filter");
		const contactSearchInput = document.getElementById("contact-search");
		const contactStatusFilter = document.getElementById("contact-status-filter");
		const contactResultsCount = document.getElementById("contact-results-count");
		const contactEmptyState = document.getElementById("contact-table-empty");
		const catalogSearchInput = document.getElementById("catalog-admin-search");
		const catalogMakeFilter = document.getElementById("catalog-admin-make");
		const catalogResultsCount = document.getElementById("catalog-results-count");
		const catalogEmptyState = document.getElementById("catalog-table-empty");
		const catalogStatus = document.getElementById("key-catalog-status");
		const newKeyCatalogForm = document.getElementById("new-key-catalog-form");
		const keyCatalogForms = Array.from(document.querySelectorAll("[data-key-catalog-form]"));

		if (
			!(
				searchInput instanceof HTMLInputElement &&
				stateFilter instanceof HTMLSelectElement &&
				payoutFilter instanceof HTMLSelectElement &&
				quoteResultsCount instanceof HTMLElement &&
				quoteEmptyState instanceof HTMLElement &&
				quoteActionStatus instanceof HTMLElement &&
				statusFilter instanceof HTMLSelectElement &&
				emailDraftPanel instanceof HTMLElement &&
				emailDraftClose instanceof HTMLElement &&
				emailDraftCloseButton instanceof HTMLButtonElement &&
				emailDraftTo instanceof HTMLElement &&
				emailDraftSubject instanceof HTMLElement &&
				emailDraftBody instanceof HTMLTextAreaElement &&
				emailDraftStatus instanceof HTMLElement &&
				emailDraftCopy instanceof HTMLButtonElement &&
				emailDraftSend instanceof HTMLButtonElement &&
				newKeyPanel instanceof HTMLElement &&
				newKeyClose instanceof HTMLElement &&
				newKeyCloseButton instanceof HTMLButtonElement &&
				openNewKeyPanelButton instanceof HTMLButtonElement &&
				contactSearchInput instanceof HTMLInputElement &&
				contactStatusFilter instanceof HTMLSelectElement &&
				contactResultsCount instanceof HTMLElement &&
				contactEmptyState instanceof HTMLElement &&
				catalogSearchInput instanceof HTMLInputElement &&
				catalogMakeFilter instanceof HTMLSelectElement &&
				catalogResultsCount instanceof HTMLElement &&
				catalogEmptyState instanceof HTMLElement &&
				catalogStatus instanceof HTMLElement &&
				newKeyCatalogForm instanceof HTMLFormElement
			)
		) {
			return;
		}

		let currentEmailDraft = {
			contactId: "",
			to: "",
			subject: "",
			body: "",
		};
		let isSendingReply = false;
		let replyTrigger: HTMLElement | null = null;

		statusFilter.value = "new";
		contactStatusFilter.value = "new";

		const applyQuoteFilters = () => {
			const searchValue = searchInput.value.trim().toLowerCase();
			const selectedState = stateFilter.value;
			const selectedPayout = payoutFilter.value;
			const selectedStatus = statusFilter.value;
			let visibleRows = 0;

			for (const row of quoteRows) {
				if (!(row instanceof HTMLElement)) {
					continue;
				}

				const matchesSearch = !searchValue || (row.dataset.search ?? "").includes(searchValue);
				const matchesState = selectedState === "all" || row.dataset.state === selectedState;
				const hasPayout = row.dataset.hasPayout === "true";
				const matchesPayout =
					selectedPayout === "all" ||
					(selectedPayout === "has-payout" && hasPayout) ||
					(selectedPayout === "missing-payout" && !hasPayout);
				const matchesStatus = selectedStatus === "all" || (row.dataset.status ?? "new") === selectedStatus;

				const isVisible = matchesSearch && matchesState && matchesPayout && matchesStatus;
				row.style.display = isVisible ? "" : "none";

				if (isVisible) {
					visibleRows += 1;
				}
			}

			quoteResultsCount.textContent = String(visibleRows);
			quoteEmptyState.classList.toggle("hidden", visibleRows > 0);
		};

		const applyContactFilters = () => {
			const searchValue = contactSearchInput.value.trim().toLowerCase();
			const selectedStatus = contactStatusFilter.value;
			let visibleRows = 0;

			for (const row of contactRows) {
				if (!(row instanceof HTMLElement)) {
					continue;
				}

				const matchesSearch = !searchValue || (row.dataset.search ?? "").includes(searchValue);
				const matchesStatus = selectedStatus === "all" || (row.dataset.status ?? "new") === selectedStatus;
				const isVisible = matchesSearch && matchesStatus;
				row.style.display = isVisible ? "" : "none";

				if (isVisible) {
					visibleRows += 1;
				}
			}

			contactResultsCount.textContent = String(visibleRows);
			contactEmptyState.classList.toggle("hidden", visibleRows > 0);
		};

		const applyCatalogFilters = () => {
			const searchValue = catalogSearchInput.value.trim().toLowerCase();
			const makeValue = catalogMakeFilter.value;
			let visibleRows = 0;

			for (const row of keyCatalogForms) {
				if (!(row instanceof HTMLElement)) {
					continue;
				}

				const matchesSearch = !searchValue || (row.dataset.search ?? "").includes(searchValue);
				const matchesMake = makeValue === "all" || row.dataset.make === makeValue;
				const isVisible = matchesSearch && matchesMake;
				row.style.display = isVisible ? "" : "none";

				if (isVisible) {
					visibleRows += 1;
				}
			}

			catalogResultsCount.textContent = String(visibleRows);
			catalogEmptyState.classList.toggle("hidden", visibleRows > 0);
		};

		const showEmailDraftPanel = (draft) => {
			if (isSendingReply) {
				return;
			}
			replyTrigger = document.activeElement instanceof HTMLElement ? document.activeElement : null;
			currentEmailDraft = draft;
			emailDraftTo.textContent = draft.to;
			emailDraftSubject.textContent = draft.subject;
			emailDraftBody.value = draft.body;
			emailDraftBody.disabled = false;
			emailDraftSend.disabled = false;
			emailDraftSend.textContent = "Send reply";
			emailDraftStatus.textContent = "";
			emailDraftStatus.classList.remove("text-red-700");
			emailDraftStatus.classList.add("text-emerald-700");
			emailDraftPanel.classList.remove("hidden");
			emailDraftPanel.classList.add("flex");
			document.body.classList.add("overflow-hidden");
			emailDraftBody.focus();
		};

		const closeEmailDraftPanel = () => {
			if (isSendingReply) {
				return;
			}
			emailDraftPanel.classList.add("hidden");
			emailDraftPanel.classList.remove("flex");
			emailDraftStatus.textContent = "";
			document.body.classList.remove("overflow-hidden");
			replyTrigger?.focus();
		};

		const openNewKeyPanel = () => {
			newKeyPanel.classList.remove("hidden");
			newKeyPanel.classList.add("flex");
			document.body.classList.add("overflow-hidden");
		};

		const closeNewKeyPanel = () => {
			newKeyPanel.classList.add("hidden");
			newKeyPanel.classList.remove("flex");
			document.body.classList.remove("overflow-hidden");
		};

		const setStatusBadgeClass = (badge, status) => {
			badge.className = "inline-flex rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-[0.12em]";
			if (status === "approved") {
				badge.classList.add("bg-emerald-100", "text-emerald-800");
				return;
			}
			if (status === "rejected") {
				badge.classList.add("bg-rose-100", "text-rose-800");
				return;
			}
			badge.classList.add("bg-amber-100", "text-amber-800");
		};

		const updateQuoteRowStatus = (quoteId, status) => {
			const row = quoteRows.find(
				(candidate) => candidate instanceof HTMLElement && candidate.querySelector(`[data-quote-id="${quoteId}"]`)
			);

			if (!(row instanceof HTMLElement)) {
				return;
			}

			row.dataset.status = status;
			const badge = row.querySelector("[data-quote-status-badge]");
			if (badge instanceof HTMLElement) {
				badge.textContent = status;
				setStatusBadgeClass(badge, status);
			}

			row.querySelectorAll("[data-current-status]").forEach((button) => {
				if (button instanceof HTMLElement) {
					button.dataset.currentStatus = status;
				}
			});

			applyQuoteFilters();
		};

		const saveQuoteStatus = async (quoteId, status) => {
			const response = await fetch("/api/admin-quote-status", {
				method: "POST",
				credentials: "same-origin",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ id: quoteId, status }),
			});

			if (!response.ok) {
				let message = "Could not update quote status.";
				try {
					const payload = await response.json();
					message = payload.error ?? message;
				} catch {
					// Keep the generic message if the server did not return JSON.
				}
				throw new Error(message);
			}

			return response.json();
		};

		const setContactStatusBadgeClass = (badge, status) => {
			badge.className = "mt-3 inline-flex rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-[0.12em]";
			if (status === "replied") {
				badge.classList.add("bg-emerald-100", "text-emerald-800");
				return;
			}
			badge.classList.add("bg-amber-100", "text-amber-800");
		};

		const updateContactRowStatus = (contactId, status) => {
			const row = contactRows.find(
				(candidate) => candidate instanceof HTMLElement && candidate.dataset.contactId === contactId
			);

			if (!(row instanceof HTMLElement)) {
				return;
			}

			row.dataset.status = status;
			const badge = row.querySelector("[data-contact-status-badge]");
			if (badge instanceof HTMLElement) {
				badge.textContent = status;
				setContactStatusBadgeClass(badge, status);
			}

			applyContactFilters();
		};

		const saveContactStatus = async (contactId, status) => {
			const response = await fetch("/api/admin-contact-status", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ id: contactId, status }),
			});

			if (!response.ok) {
				throw new Error("Could not update contact status.");
			}
		};

		const saveKeyCatalogItem = async (form) => {
			const formData = new FormData(form);
			const response = await fetch("/api/admin-key-catalog", {
				method: "POST",
				body: formData,
			});

			if (!response.ok) {
				throw new Error("Could not update key catalog item.");
			}
		};

		const buildContactReplyDraft = (button) => {
			const customerEmail = button.dataset.contactEmail ?? "";
			const subject = "Re: Your message to I Buy Car Keys";

			return {
				contactId: button.dataset.contactId ?? "",
				to: customerEmail,
				subject,
				body: "",
			};
		};

		searchInput.addEventListener("input", applyQuoteFilters);
		stateFilter.addEventListener("change", applyQuoteFilters);
		payoutFilter.addEventListener("change", applyQuoteFilters);
		statusFilter.addEventListener("change", applyQuoteFilters);
		contactSearchInput.addEventListener("input", applyContactFilters);
		contactStatusFilter.addEventListener("change", applyContactFilters);
		catalogSearchInput.addEventListener("input", applyCatalogFilters);
		catalogMakeFilter.addEventListener("change", applyCatalogFilters);

		const quoteActionButtons = [...approveButtons, ...rejectButtons, ...markNewButtons];
		const pendingQuotes = new Set<string>();
		for (const button of quoteActionButtons) {
			if (!(button instanceof HTMLButtonElement)) continue;
			button.addEventListener("click", async () => {
				const quoteId = button.dataset.quoteId ?? "";
				if (!quoteId || pendingQuotes.has(quoteId)) return;
				const status = button.hasAttribute("data-approve-quote") ? "approved"
					: button.hasAttribute("data-reject-quote") ? "rejected" : "new";
				const relatedButtons = quoteActionButtons.filter((candidate) =>
					candidate instanceof HTMLButtonElement && candidate.dataset.quoteId === quoteId);
				pendingQuotes.add(quoteId);
				for (const candidate of relatedButtons) {
					if (candidate instanceof HTMLButtonElement) candidate.disabled = true;
				}
				showQuoteActionStatus(status === "approved" ? "Approving quote and emailing the invoice?"
					: status === "rejected" ? "Rejecting quote and emailing the customer?" : "Updating quote?");
				try {
					const result = await saveQuoteStatus(quoteId, status);
					updateQuoteRowStatus(quoteId, status);
					if (status === "new") {
						showQuoteActionStatus("Quote marked new.");
					} else if (result.emailSent) {
						showQuoteActionStatus(status === "approved"
							? "Quote approved. Email sent with the PDF invoice attached."
							: "Quote rejected and email sent.");
					} else {
						showQuoteActionStatus(
							`Quote marked ${status}, but the email was not sent: ${result.emailError || "Unknown email error"}. Click ${status === "approved" ? "Approve" : "Reject"} again to retry.`,
							"error");
					}
				} catch (error) {
					showQuoteActionStatus(error instanceof Error ? error.message : "Could not update quote.", "error");
				} finally {
					pendingQuotes.delete(quoteId);
					for (const candidate of relatedButtons) {
						if (candidate instanceof HTMLButtonElement) candidate.disabled = false;
					}
				}
			});
		}

		emailDraftClose.addEventListener("click", closeEmailDraftPanel);
		emailDraftCloseButton.addEventListener("click", closeEmailDraftPanel);
		openNewKeyPanelButton.addEventListener("click", openNewKeyPanel);
		newKeyClose.addEventListener("click", closeNewKeyPanel);
		newKeyCloseButton.addEventListener("click", closeNewKeyPanel);

		emailDraftCopy.addEventListener("click", async () => {
			currentEmailDraft.body = emailDraftBody.value;
			const fullDraft = [`To: ${currentEmailDraft.to}`, `Subject: ${currentEmailDraft.subject}`, "", currentEmailDraft.body].join("\n");

			try {
				await navigator.clipboard.writeText(fullDraft);
				emailDraftStatus.textContent = "Email draft copied to your clipboard.";
			} catch {
				emailDraftStatus.textContent = "Could not copy automatically. Select and copy the draft manually.";
			}
		});

		emailDraftSend.addEventListener("click", async () => {
			if (isSendingReply || emailDraftSend.disabled || !currentEmailDraft.contactId) {
				return;
			}
			const message = emailDraftBody.value.trim();
			emailDraftStatus.classList.remove("text-red-700");
			emailDraftStatus.classList.add("text-emerald-700");
			if (!message) {
				emailDraftStatus.textContent = "Enter your reply before sending.";
				emailDraftBody.focus();
				return;
			}

			const contactId = currentEmailDraft.contactId;
			isSendingReply = true;
			emailDraftSend.disabled = true;
			emailDraftBody.disabled = true;
			emailDraftSend.textContent = "Sending…";
			emailDraftStatus.textContent = "Sending your reply…";
			try {
				const response = await fetch("/api/admin-contact-reply", {
					method: "POST",
					credentials: "same-origin",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({ id: contactId, message }),
				});
				const result = await response.json();
				if (!response.ok || !result.emailSent) {
					throw new Error(result.error || "Could not send your reply.");
				}
				if (result.status === "replied") {
					updateContactRowStatus(contactId, "replied");
				}
				emailDraftSend.textContent = "Reply sent";
				emailDraftStatus.textContent = result.warning || "Your reply was sent and the contact message is marked as replied.";
				if (result.warning) {
					emailDraftStatus.classList.replace("text-emerald-700", "text-red-700");
				}
			} catch (error) {
				emailDraftStatus.textContent = error instanceof Error ? error.message : "Could not send your reply.";
				emailDraftStatus.classList.replace("text-emerald-700", "text-red-700");
				emailDraftSend.disabled = false;
				emailDraftBody.disabled = false;
				emailDraftSend.textContent = "Send reply";
			} finally {
				isSendingReply = false;
			}
		});

		for (const button of replyContactButtons) {
			if (!(button instanceof HTMLButtonElement)) {
				continue;
			}

			button.addEventListener("click", () => {
				showEmailDraftPanel(buildContactReplyDraft(button));
			});
		}

		for (const button of markNewContactButtons) {
			if (!(button instanceof HTMLButtonElement)) {
				continue;
			}

			button.addEventListener("click", async () => {
				const contactId = button.dataset.contactId ?? "";
				try {
					await saveContactStatus(contactId, "new");
					updateContactRowStatus(contactId, "new");
				} catch {
					window.alert("Could not update this message back to New.");
				}
			});
		}

		for (const form of keyCatalogForms) {
			if (!(form instanceof HTMLFormElement)) {
				continue;
			}

			form.addEventListener("submit", async (event) => {
				event.preventDefault();
				const submitEvent = event as SubmitEvent;
				const submitter = submitEvent.submitter;
				const actionInput = form.querySelector('input[name="action"]');
				const nextAction = submitter instanceof HTMLElement && submitter.dataset.action === "delete" ? "delete" : "update";
				const sku = (new FormData(form).get("sku") ?? "").toString();

				if (!(actionInput instanceof HTMLInputElement)) {
					catalogStatus.textContent = "Could not submit this catalog item.";
					return;
				}

				if (nextAction === "delete") {
					const confirmed = window.confirm(`Delete ${sku}? This cannot be undone.`);
					if (!confirmed) {
						return;
					}
				}

				actionInput.value = nextAction;
				catalogStatus.textContent = nextAction === "delete" ? "Deleting catalog item..." : "Saving catalog item...";
				try {
					await saveKeyCatalogItem(form);
					catalogStatus.textContent =
						nextAction === "delete" ? `${sku} was deleted. Refresh to update the list.` : `${sku} was updated.`;
				} catch {
					catalogStatus.textContent =
						nextAction === "delete" ? "Could not delete this catalog item." : "Could not update this catalog item.";
				} finally {
					actionInput.value = "update";
				}
			});
		}

		newKeyCatalogForm.addEventListener("submit", async (event) => {
			event.preventDefault();
			catalogStatus.textContent = "Adding key to the catalog...";
			try {
				await saveKeyCatalogItem(newKeyCatalogForm);
				catalogStatus.textContent = "New key created successfully. Refresh the page to see it in the catalog.";
				newKeyCatalogForm.reset();
				closeNewKeyPanel();
			} catch {
				catalogStatus.textContent = "Could not create this key catalog item.";
			}
		});

		applyQuoteFilters();
		applyContactFilters();
		applyCatalogFilters();

		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape") {
				if (emailDraftPanel.classList.contains("flex")) {
					closeEmailDraftPanel();
				}

				if (newKeyPanel.classList.contains("flex")) {
					closeNewKeyPanel();
				}
			}
		});
	});
</script>
