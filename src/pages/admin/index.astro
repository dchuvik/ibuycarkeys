---
import Container from "~/components/Container.astro";
import Section from "~/components/Section.astro";
import Layout from "~/layouts/Layout.astro";
import { getAccountRole, getAccountUser } from "~/lib/accountAuth";
import { getSupabaseAdmin, isSupabaseAdminConfigured } from "~/lib/supabaseAdmin";
import { supabaseTables } from "~/lib/supabaseTables";

export const prerender = false;

const accountUser = await getAccountUser(Astro.cookies, Astro.url.protocol === "https:");
const accountRole = accountUser ? await getAccountRole(accountUser.id) : "customer";
const isAuthenticated = Boolean(accountUser && accountRole === "admin");
const loginError = Astro.url.searchParams.get("error");
const isConfigured = isSupabaseAdminConfigured();

type ContactMessage = {
	id: string;
	first_name: string;
	last_name: string;
	email: string;
	phone_number: string | null;
	message: string;
	source_page: string | null;
	submitted_at: string;
	created_at: string;
	client_timezone: string | null;
	client_utc_offset_minutes: number | null;
	status: "new" | "replied" | null;
};

type QuoteRequest = {
	id: string;
	customer_name: string;
	customer_email: string;
	customer_phone: string;
	customer_address: string;
	customer_city: string;
	customer_state: string;
	customer_zip: string;
	quote_summary: string;
	total_keys: number | null;
	estimated_payout: string | null;
	source_page: string | null;
	submitted_at: string;
	created_at: string;
	client_timezone: string | null;
	client_utc_offset_minutes: number | null;
	status: "new" | "approved" | "rejected" | null;
};

type KeyCatalogItem = {
	sku: string;
	make: string;
	key_type: string | null;
	description: string;
	excellent_price: number;
	light_scratches_price: number | null;
	worn_price: number | null;
	image_url: string | null;
	inventory_count: number;
	active: boolean;
};

let contacts: ContactMessage[] = [];
let quotes: QuoteRequest[] = [];
let keyCatalogItems: KeyCatalogItem[] = [];
let loadError = "";

const formatDateTime = (value: string) =>
	new Intl.DateTimeFormat("en-US", {
		dateStyle: "medium",
		timeStyle: "short",
	}).format(new Date(value));

const formatDateTimeForTimezone = (value: string, timeZone?: string | null) => {
	try {
		return new Intl.DateTimeFormat("en-US", {
			dateStyle: "medium",
			timeStyle: "short",
			...(timeZone ? { timeZone } : {}),
		}).format(new Date(value));
	} catch {
		return formatDateTime(value);
	}
};

const formatCompactDate = (value: string) =>
	new Intl.DateTimeFormat("en-US", {
		month: "short",
		day: "numeric",
		year: "numeric",
	}).format(new Date(value));

const quoteStates = new Set<string>();

if (isAuthenticated && isConfigured) {
	try {
		const supabaseAdmin = getSupabaseAdmin();
		const [
			{ data: contactData, error: contactError },
			{ data: quoteData, error: quoteError },
			{ data: keyCatalogData, error: keyCatalogError },
		] = await Promise.all([
			supabaseAdmin
				.from(supabaseTables.contactMessages)
				.select("*")
				.order("created_at", { ascending: false })
				.limit(100),
			supabaseAdmin
				.from(supabaseTables.quoteRequests)
				.select("*")
				.order("created_at", { ascending: false })
				.limit(100),
			supabaseAdmin.from("key_catalog_items").select("*").order("make", { ascending: true }).order("sku", { ascending: true }),
		]);

		if (contactError) {
			throw contactError;
		}

		if (quoteError) {
			throw quoteError;
		}

		contacts = (contactData ?? []) as ContactMessage[];
		quotes = (quoteData ?? []) as QuoteRequest[];
		keyCatalogItems = keyCatalogError ? [] : ((keyCatalogData ?? []) as KeyCatalogItem[]);

		for (const quote of quotes) {
			if (quote.customer_state) {
				quoteStates.add(quote.customer_state.toUpperCase());
			}
		}
	} catch (error) {
		loadError = error instanceof Error ? error.message : "Could not load submission data.";
	}
}

const sortedQuoteStates = Array.from(quoteStates).sort((left, right) => left.localeCompare(right));
const keyTypeOptions = ["smart", "flip", "rhk", "fobik", "remote"];
const quoteStatusCounts = {
	new: quotes.filter((quote) => (quote.status ?? "new") === "new").length,
	approved: quotes.filter((quote) => quote.status === "approved").length,
	rejected: quotes.filter((quote) => quote.status === "rejected").length,
};
const contactStatusCounts = {
	new: contacts.filter((contact) => (contact.status ?? "new") === "new").length,
	replied: contacts.filter((contact) => contact.status === "replied").length,
};
---

<Layout
	pageTitle="Admin"
	title="Admin"
	description="Internal submission dashboard"
	noindex={true}
>
	<Section class:list={"bg-gradient-to-br from-stone-100 via-white to-amber-50"}>
		<Container>
			<div class="mx-auto max-w-7xl space-y-8">
				<div
					id="email-draft-panel"
					role="dialog"
					aria-modal="true"
					aria-labelledby="email-draft-title"
					class="fixed inset-0 z-50 hidden items-start justify-center overflow-y-auto bg-gray-950/70 px-4 py-4 sm:items-center sm:p-4"
				>
					<div id="email-draft-close" class="absolute inset-0"></div>
					<div class="relative z-10 my-auto w-full max-w-2xl max-h-[88vh] overflow-y-auto rounded-[2rem] bg-white p-6 shadow-2xl ring-1 ring-gray-200">
						<div class="flex items-start justify-between gap-4">
							<div>
								<p class="text-sm font-semibold uppercase tracking-[0.18em] text-amber-700">Email draft</p>
								<h2 id="email-draft-title" class="mt-2 text-2xl font-bold text-gray-950">Review and send</h2>
								<p class="mt-2 text-sm leading-6 text-gray-600">
									Write your reply below, then choose Send reply. The contact will be marked as replied after your email is sent.
								</p>
							</div>
							<button
								type="button"
								id="email-draft-close-button"
								class="inline-flex size-11 items-center justify-center rounded-full border border-gray-200 text-xl leading-none text-gray-500 transition hover:border-gray-300 hover:text-gray-700"
								aria-label="Close email draft"
							>
								&times;
							</button>
						</div>

						<div class="mt-5 space-y-4">
							<div>
								<p class="text-xs font-semibold uppercase tracking-[0.12em] text-gray-500">To</p>
								<p id="email-draft-to" class="mt-2 rounded-2xl bg-stone-50 px-4 py-3 text-sm text-gray-800 ring-1 ring-gray-200"></p>
							</div>
							<div>
								<p class="text-xs font-semibold uppercase tracking-[0.12em] text-gray-500">Subject</p>
								<p id="email-draft-subject" class="mt-2 rounded-2xl bg-stone-50 px-4 py-3 text-sm text-gray-800 ring-1 ring-gray-200"></p>
							</div>
							<div>
								<label for="email-draft-body" class="text-xs font-semibold uppercase tracking-[0.12em] text-gray-500">Message</label>
								<textarea
									id="email-draft-body"
									rows="10"
									maxlength="10000"
									placeholder="Type your reply here. Your greeting, signature, and the original message will be included automatically."
									class="mt-2 min-h-56 w-full rounded-2xl bg-stone-50 px-4 py-4 text-sm leading-6 text-gray-800 ring-1 ring-gray-200"
								></textarea>
							</div>
						</div>

						<p id="email-draft-status" role="status" aria-live="polite" class="mt-4 text-sm text-emerald-700"></p>

						<div class="mt-5 flex flex-col gap-3 sm:flex-row sm:justify-end">
							<button
								type="button"
								id="email-draft-copy"
								class="button button-white min-h-11 rounded-full border border-gray-200 px-5 text-sm"
							>
								Copy email
							</button>
							<button
								type="button"
								id="email-draft-send"
								class="button button-black min-h-11 rounded-full px-5 text-sm disabled:cursor-not-allowed disabled:opacity-60"
							>
								Send reply
							</button>
						</div>
					</div>
				</div>

				<div
					id="new-key-panel"
					class="fixed inset-0 z-50 hidden items-start justify-center overflow-y-auto bg-gray-950/70 px-4 py-4 sm:items-center sm:p-4"
				>
					<div id="new-key-close" class="absolute inset-0"></div>
					<div class="relative z-10 my-auto w-full max-w-5xl max-h-[88vh] overflow-y-auto rounded-[2rem] bg-white p-6 shadow-2xl ring-1 ring-gray-200">
						<div class="flex items-start justify-between gap-4">
							<div>
								<p class="text-sm font-semibold uppercase tracking-[0.18em] text-amber-700">Catalog admin</p>
								<h2 class="mt-2 text-2xl font-bold text-gray-950">Add new key</h2>
								<p class="mt-2 text-sm leading-6 text-gray-600">
									Create a new catalog item with pricing, inventory details, and an uploaded image.
								</p>
							</div>
							<button
								type="button"
								id="new-key-close-button"
								class="inline-flex size-11 items-center justify-center rounded-full border border-gray-200 text-xl leading-none text-gray-500 transition hover:border-gray-300 hover:text-gray-700"
								aria-label="Close new key form"
							>
								&times;
							</button>
						</div>

						<form
							id="new-key-catalog-form"
							class="mt-6 grid grid-cols-1 gap-4 rounded-[1.5rem] border border-dashed border-amber-300 bg-amber-50/60 p-5 shadow-sm xl:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)_120px_120px_120px_110px_120px]"
						>
							<div class="xl:col-span-2">
								<div class="grid grid-cols-1 gap-4 md:grid-cols-3">
									<div>
										<label for="new-key-sku">SKU</label>
										<input id="new-key-sku" name="sku" type="text" placeholder="TOY.31" required />
									</div>
									<div>
										<label for="new-key-make">Make</label>
										<input id="new-key-make" name="make" type="text" placeholder="Toyota" required />
									</div>
									<div>
										<label for="new-key-type">Key type</label>
										<select id="new-key-type" name="keyType">
											<option value="">Select key type</option>
											{keyTypeOptions.map((keyType) => <option value={keyType}>{keyType}</option>)}
										</select>
									</div>
								</div>
								<div class="mt-4">
									<label for="new-key-description">Description</label>
									<textarea
										id="new-key-description"
										name="description"
										rows="3"
										class="min-h-28"
										placeholder="Toyota Smart Key FCC ID..."
										required
									></textarea>
								</div>
								<div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
									<div>
										<label for="new-key-image-file">Key image</label>
										<input id="new-key-image-file" name="imageFile" type="file" accept="image/*" />
									</div>
									<div>
										<label for="new-key-image-url">Or image URL</label>
										<input id="new-key-image-url" name="imageUrl" type="url" placeholder="https://..." />
									</div>
								</div>
							</div>
							<div>
								<label for="new-key-excellent-price">No scratches</label>
								<div class="relative">
									<span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-sm font-semibold text-gray-500">$</span>
									<input id="new-key-excellent-price" name="excellentPrice" type="number" min="0" step="0.01" value="0" class="pl-7" required />
								</div>
							</div>
							<div>
								<label for="new-key-light-scratches-price">Light scratches</label>
								<div class="relative">
									<span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-sm font-semibold text-gray-500">$</span>
									<input id="new-key-light-scratches-price" name="lightScratchesPrice" type="number" min="0" step="0.01" class="pl-7" />
								</div>
							</div>
							<div>
								<label for="new-key-worn-price">Worn</label>
								<div class="relative">
									<span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-sm font-semibold text-gray-500">$</span>
									<input id="new-key-worn-price" name="wornPrice" type="number" min="0" step="0.01" class="pl-7" />
								</div>
							</div>
							<div>
								<label for="new-key-inventory-count">On hand</label>
								<input id="new-key-inventory-count" name="inventoryCount" type="number" min="0" step="1" value="0" />
							</div>
							<div class="flex flex-col justify-between gap-3">
								<label class="flex items-center gap-2 pt-7 text-sm font-medium text-gray-700">
									<input name="active" type="checkbox" checked />
									<span>Active</span>
								</label>
								<input type="hidden" name="action" value="create" />
								<button type="submit" class="button button-black min-h-11 rounded-full px-4 text-sm">Add key</button>
							</div>
						</form>
					</div>
				</div>

				<div class="flex flex-col gap-4 rounded-[2rem] bg-gray-950 px-6 py-8 text-white shadow-2xl sm:px-8">
					<p class="text-sm font-semibold uppercase tracking-[0.22em] text-amber-300">Internal dashboard</p>
					<h1 class="text-4xl font-bold tracking-[-0.03em]">Submission admin</h1>
					<p class="max-w-3xl text-sm leading-6 text-gray-300">
						Review quote orders and contact submissions collected through the website.
					</p>
				</div>

				{
					!isConfigured && (
						<div class="rounded-3xl border border-amber-200 bg-amber-50 px-6 py-5 text-amber-950 shadow-sm">
							<p class="text-sm font-semibold uppercase tracking-[0.16em] text-amber-700">Setup needed</p>
							<p class="mt-2 text-sm leading-6">
								Add `SUPABASE_URL`, `SUPABASE_ANON_KEY`, and `SUPABASE_SERVICE_ROLE_KEY` to your environment before using
								account authentication.
							</p>
						</div>
					)
				}

				{
					!isAuthenticated ? (
						<div class="mx-auto max-w-xl rounded-[2rem] bg-white p-6 shadow-xl ring-1 ring-gray-200 sm:p-8">
							<p class="text-sm font-semibold uppercase tracking-[0.18em] text-amber-700">Admin access</p>
							<h2 class="mt-2 text-3xl font-bold text-gray-950">Sign in to view submissions</h2>
							<p class="mt-3 text-sm leading-6 text-gray-600">
								Use a Supabase account with the admin role. Authentication is stored in secure HttpOnly cookies.
							</p>

							{
								(loginError === "invalid" || accountUser) && (
									<div class="mt-5 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700">
										{accountUser ? "This account does not have admin access." : "The email or password was incorrect."}
									</div>
								)
							}

							{
								loginError === "setup" && (
									<div class="mt-5 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-medium text-amber-900">
										The admin dashboard is not configured yet.
									</div>
								)
							}

							<form method="POST" action="/api/account-login" class="mt-6 space-y-4">
								<input type="hidden" name="returnTo" value="/admin/" />
								<div>
									<label for="admin-email">Email address</label>
									<input
										id="admin-email"
										name="email"
										type="email"
										autocomplete="email"
										required
									/>
								</div>
								<div>
									<label for="admin-password">Admin password</label>
									<input
										id="admin-password"
										name="password"
										type="password"
										autocomplete="current-password"
										required
									/>
								</div>
								<button type="submit" class="button button-black min-h-12 rounded-full px-6">
									Open dashboard
								</button>
							</form>
						</div>
					) : (
						<div class="flex flex-col gap-8">
							<div class="flex flex-col gap-4 rounded-3xl bg-white px-6 py-5 shadow-sm ring-1 ring-gray-200 sm:flex-row sm:items-center sm:justify-between">
								<div>
									<p class="text-sm font-semibold uppercase tracking-[0.16em] text-amber-700">Live data</p>
									<p class="mt-2 text-sm text-gray-600">
										Showing the 100 most recent entries from each submission table.
									</p>
								</div>
								<form method="POST" action="/api/account-logout">
									<button type="submit" class="button button-white min-h-11 rounded-full border border-gray-200 px-5">
										Log out
									</button>
								</form>
							</div>

							{
								loadError && (
									<div class="rounded-3xl border border-red-200 bg-red-50 px-6 py-5 text-sm text-red-700">
										{loadError}
									</div>
								)
							}

							<div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4">
								<div class="rounded-3xl bg-white px-6 py-5 shadow-sm ring-1 ring-gray-200">
									<p class="text-sm font-semibold uppercase tracking-[0.16em] text-gray-500">New orders</p>
									<p class="mt-3 text-4xl font-bold tracking-[-0.03em] text-gray-950">{quoteStatusCounts.new}</p>
								</div>
								<div class="rounded-3xl bg-white px-6 py-5 shadow-sm ring-1 ring-gray-200">
									<p class="text-sm font-semibold uppercase tracking-[0.16em] text-gray-500">New messages</p>
									<p class="mt-3 text-4xl font-bold tracking-[-0.03em] text-gray-950">{contactStatusCounts.new}</p>
								</div>
								<div class="rounded-3xl bg-white px-6 py-5 shadow-sm ring-1 ring-gray-200">
									<p class="text-sm font-semibold uppercase tracking-[0.16em] text-gray-500">Approved quotes</p>
									<p class="mt-3 text-4xl font-bold tracking-[-0.03em] text-emerald-700">{quoteStatusCounts.approved}</p>
								</div>
								<div class="rounded-3xl bg-white px-6 py-5 shadow-sm ring-1 ring-gray-200">
									<p class="text-sm font-semibold uppercase tracking-[0.16em] text-gray-500">Rejected quotes</p>
									<p class="mt-3 text-4xl font-bold tracking-[-0.03em] text-rose-700">{quoteStatusCounts.rejected}</p>
								</div>
							</div>

							<nav
								class="flex gap-2 overflow-x-auto rounded-2xl bg-gray-900 p-2 shadow-lg"
								role="tablist"
								aria-label="Admin dashboard sections"
							>
								<button
									type="button"
									id="admin-tab-quotes"
									class="inline-flex min-h-12 shrink-0 items-center gap-2 rounded-xl bg-white px-5 text-sm font-bold text-gray-950 shadow-sm transition"
									role="tab"
									aria-selected="true"
									aria-controls="admin-panel-quotes"
									data-admin-tab="quotes"
									tabindex="0"
								>
									Quote form
									<span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-600">{quotes.length}</span>
								</button>
								<button
									type="button"
									id="admin-tab-contacts"
									class="inline-flex min-h-12 shrink-0 items-center gap-2 rounded-xl px-5 text-sm font-bold text-gray-300 transition hover:bg-white/10 hover:text-white"
									role="tab"
									aria-selected="false"
									aria-controls="admin-panel-contacts"
									data-admin-tab="contacts"
									tabindex="-1"
								>
									Contact form
									<span class="rounded-full bg-white/10 px-2 py-0.5 text-xs">{contacts.length}</span>
								</button>
								<button
									type="button"
									id="admin-tab-catalog"
									class="inline-flex min-h-12 shrink-0 items-center gap-2 rounded-xl px-5 text-sm font-bold text-gray-300 transition hover:bg-white/10 hover:text-white"
									role="tab"
									aria-selected="false"
									aria-controls="admin-panel-catalog"
									data-admin-tab="catalog"
									tabindex="-1"
								>
									Catalog admin
									<span class="rounded-full bg-white/10 px-2 py-0.5 text-xs">{keyCatalogItems.length}</span>
								</button>
							</nav>

							<div
								id="admin-panel-quotes"
								class="space-y-6 rounded-[2rem] bg-white p-6 shadow-xl ring-1 ring-gray-200"
								role="tabpanel"
								aria-labelledby="admin-tab-quotes"
								data-admin-panel="quotes"
							>
								<div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
									<div>
										<p class="text-sm font-semibold uppercase tracking-[0.16em] text-amber-700">Quote form</p>
										<h2 class="mt-2 text-3xl font-bold text-gray-950">Quote orders</h2>
										<p class="mt-2 text-sm text-gray-600">
											Search by customer, email, phone, address, payout, or quote details. Filter by state or payout availability.
										</p>
									</div>
									<p class="text-sm font-medium text-gray-500">
										Visible rows: <span id="quote-results-count" class="font-bold text-gray-950">{quotes.length}</span>
									</p>
								</div>

								<div class="rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-950">
									Approve and Reject email the customer directly. Approval automatically attaches a PDF invoice.
								</div>
								<p id="quote-action-status" class="hidden rounded-2xl bg-slate-100 px-4 py-3 text-sm font-semibold text-slate-800 ring-1 ring-slate-200"></p>

								<div class="grid grid-cols-1 gap-4 xl:grid-cols-[minmax(0,1.4fr)_200px_200px_200px]">
									<div>
										<label for="quote-search">Search orders</label>
										<input
											id="quote-search"
											type="search"
											placeholder="Search name, email, phone, address, payout, or summary"
										/>
									</div>
									<div>
										<label for="quote-state-filter">State</label>
										<select id="quote-state-filter">
											<option value="all">All states</option>
											{
												sortedQuoteStates.map((state) => (
													<option value={state}>{state}</option>
												))
											}
										</select>
									</div>
									<div>
										<label for="quote-payout-filter">Payout</label>
										<select id="quote-payout-filter">
											<option value="all">Any payout</option>
											<option value="has-payout">Has payout</option>
											<option value="missing-payout">Missing payout</option>
										</select>
									</div>
									<div>
										<label for="quote-status-filter">Status</label>
										<select id="quote-status-filter">
											<option value="all">All statuses</option>
