---
import Layout from "~/layouts/Layout.astro";
import Section from "~/components/Section.astro";
import Container from "~/components/Container.astro";
import { getAccountRole, getAccountUser } from "~/lib/accountAuth";

export const prerender = false;

const user = await getAccountUser(Astro.cookies, Astro.url.protocol === "https:");
if (user) {
	const role = await getAccountRole(user.id);
	return Astro.redirect(role === "admin" && Astro.url.searchParams.get("returnTo") === "/admin/" ? "/admin/" : "/account/");
}

const error = Astro.url.searchParams.get("error");
const registered = Astro.url.searchParams.get("registered") === "true";
const confirmed = Astro.url.searchParams.get("confirmed") === "true";
const requestedReturnTo = Astro.url.searchParams.get("returnTo") ?? "/account/";
const returnTo = requestedReturnTo.startsWith("/") && !requestedReturnTo.startsWith("//") ? requestedReturnTo : "/account/";
---

<Layout pageTitle="Sign in | I Buy Car Keys" title="Sign in" description="Sign in to view and track your car key quotes." noindex={true}>
	<Section class:list={"bg-gradient-to-br from-slate-100 via-white to-sky-50"}>
		<Container>
			<div class="mx-auto max-w-lg rounded-[2rem] bg-white p-7 shadow-xl ring-1 ring-gray-200 sm:p-10">
				<p class="text-sm font-semibold uppercase tracking-[0.18em] text-sky-700">Your account</p>
				<h1 class="mt-3 text-4xl font-bold tracking-[-0.03em] text-gray-950">Welcome back</h1>
				<p class="mt-3 text-base text-gray-600">Sign in to review your quote history and current statuses.</p>

				{(registered || confirmed) && (
					<p class="mt-6 rounded-2xl bg-emerald-50 px-4 py-3 text-sm text-emerald-800 ring-1 ring-emerald-200">
						{confirmed ? "Your email is confirmed. You can sign in now." : "Check your email to confirm your account, then sign in."}
					</p>
				)}
				{error && (
					<p class="mt-6 rounded-2xl bg-red-50 px-4 py-3 text-sm text-red-700 ring-1 ring-red-200">
						The email or password was incorrect.
					</p>
				)}

				<form method="POST" action="/api/account-login" class="mt-7 space-y-5">
					<input type="hidden" name="returnTo" value={returnTo} />
					<div>
						<label for="login-email">Email address</label>
						<input id="login-email" name="email" type="email" autocomplete="email" required />
					</div>
					<div>
						<label for="login-password">Password</label>
						<input id="login-password" name="password" type="password" autocomplete="current-password" required />
					</div>
					<button type="submit" class="button button-black min-h-12 w-full rounded-full px-6">Sign in</button>
				</form>

				<p class="mt-6 text-center text-sm text-gray-600">
					Need an account? <a href="/register/" class="font-bold text-gray-950 underline underline-offset-4">Create one</a>
				</p>
			</div>
		</Container>
	</Section>
</Layout>

