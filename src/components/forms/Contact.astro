---
import { getContactProtection } from "~/lib/contactProtection";
const protection = getContactProtection();
const protectionUnavailable = protection.enabled && !protection.configured;
const wasSubmitted = Astro.url.searchParams.get("submitted") === "true";
const hasError = Astro.url.searchParams.has("error");
---

{
	wasSubmitted && (
		<div data-toast-on-load data-toast-kind="success" data-toast-params="submitted" class="mb-6 rounded-2xl bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-800 ring-1 ring-emerald-200">
			Your message was sent successfully. We will get back to you soon.
		</div>
	)
}

{
	hasError && (
		<div data-toast-on-load data-toast-kind="error" data-toast-params="error" class="mb-6 rounded-2xl bg-red-50 px-4 py-3 text-sm font-medium text-red-700 ring-1 ring-red-200">
			Your message could not be sent right now. Please try again.
		</div>
	)
}

<form
	name="contact"
	method="POST"
	action="/api/contact-request.json"
	id="contact-form"
>
	<div class="hidden" aria-hidden="true">
		<label for="contact-bot-field">Leave this field empty</label>
		<input type="text" name="bot-field" id="contact-bot-field" tabindex="-1" autocomplete="off" />
	</div>
	<input type="hidden" name="client_timezone" id="contact-client-timezone" />
	<input type="hidden" name="client_utc_offset_minutes" id="contact-client-utc-offset" />

	<div class="grid grid-cols-1 gap-x-8 gap-y-6 sm:grid-cols-2">
		<div>
			<label for="first-name">First name</label>
			<div>
				<input type="text" name="first-name" id="first-name" autocomplete="given-name" maxlength="100" required />
			</div>
		</div>
		<div>
			<label for="last-name">Last name</label>
			<div>
				<input type="text" name="last-name" id="last-name" autocomplete="family-name" maxlength="100" required />
			</div>
		</div>
		<div class="sm:col-span-2">
			<label for="email">Email</label>
			<div>
				<input type="email" name="email" id="email" autocomplete="email" maxlength="254" required />
			</div>
		</div>
		<div class="sm:col-span-2">
			<label for="phone-number">Phone number</label>
			<div>
				<input type="tel" name="phone-number" id="phone-number" autocomplete="tel" maxlength="50" />
			</div>
		</div>
		<div class="sm:col-span-2">
			<label for="message">Message</label>
			<div>
				<textarea name="message" id="message" rows="4" maxlength="10000" required></textarea>
			</div>
		</div>
	</div>
	{protection.configured && (
		<div class="mt-6">
			<div id="contact-challenge" data-sitekey={protection.siteKey}></div>
			<p id="contact-challenge-status" class="mt-2 text-sm text-gray-700" role="status">Checking your browser...</p>
			<noscript><p>Please enable JavaScript to complete the security check and send your message.</p></noscript>
		</div>
	)}
	{protectionUnavailable && (
		<p role="alert" class="mt-6 text-sm text-red-700">The security check is temporarily unavailable. Please try again shortly.</p>
	)}
	<div class="mt-8 flex justify-end">
		<button type="submit" class="button button-yellow" disabled={protectionUnavailable}>Send message</button>
	</div>
</form>
<p id="contact-form-status" class="mt-4 text-sm text-gray-700"></p>

<script>
	import { showToast } from "~/lib/toast";
	import { mountContactChallenge } from "~/lib/contactChallenge";
	document.addEventListener("astro:page-load", () => {
		const form = document.getElementById("contact-form");
		const timezoneField = document.getElementById("contact-client-timezone");
		const utcOffsetField = document.getElementById("contact-client-utc-offset");

		if (
			!(
				form instanceof HTMLFormElement &&
				timezoneField instanceof HTMLInputElement &&
				utcOffsetField instanceof HTMLInputElement
			)
		) {
			return;
		}
		if (form.dataset.contactInitialized) return;
		form.dataset.contactInitialized = "true";
		const challengeContainer = document.getElementById("contact-challenge");
		const challenge = challengeContainer instanceof HTMLElement
			? mountContactChallenge(challengeContainer, document.getElementById("contact-challenge-status")) : null;
		document.addEventListener("astro:before-swap", () => challenge?.destroy(), { once: true });

		timezoneField.value = Intl.DateTimeFormat().resolvedOptions().timeZone ?? "";
		utcOffsetField.value = String(new Date().getTimezoneOffset() * -1);

		let isSubmitting = false;
		form.addEventListener("submit", async (event) => {
			event.preventDefault();

			if (isSubmitting || !form.reportValidity()) {
				return;
			}
			if (challenge && !challenge.isComplete()) {
				showToast("Please complete the security check below before sending your message.", { kind: "error", id: "contact-submit" });
				return;
			}
			isSubmitting = true;
			showToast("Sending your message...", { kind: "loading", id: "contact-submit" });
			const status = document.getElementById("contact-form-status");
			if (status) status.textContent = "Sending your message...";
			const submitButton = form.querySelector('button[type="submit"]');
			if (submitButton instanceof HTMLButtonElement) {
				submitButton.disabled = true;
				submitButton.textContent = "Sending…";
			}

			const formData = new FormData(form);
			const payload = new URLSearchParams();

			formData.forEach((value, key) => {
				payload.append(key, String(value));
			});

			try {
				const response = await fetch("/api/contact-request.json", {
					method: "POST",
					headers: {
						Accept: "application/json",
						"Content-Type": "application/x-www-form-urlencoded",
					},
					body: payload.toString(),
				});

				const result = await response.json().catch(() => null);
				if (!response.ok || !result?.ok) {
					throw new Error(result?.error || "Your message could not be sent. Please try again.");
				}

				const message = "Your message was sent successfully. We will get back to you soon.";
				showToast(message, { id: "contact-submit" });
				if (status) status.textContent = message;
				form.reset();
				timezoneField.value = Intl.DateTimeFormat().resolvedOptions().timeZone ?? "";
				utcOffsetField.value = String(new Date().getTimezoneOffset() * -1);
			} catch (error) {
				const message = error instanceof Error && !(error instanceof TypeError) ? error.message : "Your message could not be sent. Please try again.";
				showToast(message, { kind: "error", id: "contact-submit" });
				if (status) status.textContent = message;
			} finally {
				// Tokens are single-use, including when saving fails after verification.
				challenge?.reset();
				isSubmitting = false;
				if (submitButton instanceof HTMLButtonElement) {
					submitButton.disabled = false;
					submitButton.textContent = "Send message";
				}
			}
		});
	});
</script>
