---
import KeyProductImage from "./KeyProductImage.astro";

const {
	title = "Browse the key catalog",
	description = "Filter by make, search by SKU or FCC ID, and pick the key that matches what you have.",
	scrollClass = "h-[70rem]",
	showHeader = true,
} = Astro.props;
---

<section id="price-catalog" class="rounded-3xl bg-white p-6 shadow-sm ring-1 ring-gray-100 lg:p-8">
	{showHeader && (
		<div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
			<div class="max-w-3xl">
				<p class="text-sm font-semibold uppercase tracking-[0.2em] text-sky-700">Price list</p>
				<h2 class="mt-2 text-3xl font-bold">{title}</h2>
				<p class="mt-3 text-gray-600">{description}</p>
			</div>
			<div class="rounded-2xl bg-slate-50 px-4 py-3 ring-1 ring-slate-200">
				<p class="text-xs font-semibold uppercase tracking-[0.16em] text-sky-800">Browse results</p>
				<p id="catalog-results-count" class="mt-1 text-sm text-gray-700">Loading keys...</p>
			</div>
		</div>
	)}

	<div class:list={[showHeader ? "mt-6" : "", "grid grid-cols-1 gap-4 lg:grid-cols-[220px_220px_minmax(0,1fr)]"]}>
		<div>
			<label for="catalog-make">Make</label>
			<select id="catalog-make" disabled><option value="all">All makes</option></select>
		</div>
		<div>
			<label for="catalog-key-type">Key type</label>
			<select id="catalog-key-type" disabled><option value="all">All key types</option></select>
		</div>
		<div>
			<label for="catalog-search">Search catalog</label>
			<input id="catalog-search" type="search" placeholder="Search SKU, description, FCC ID..." autocomplete="off" disabled />
		</div>
	</div>
	<div class="mt-4 grid grid-cols-1 gap-4 lg:max-w-[240px]">
		<div>
			<label for="catalog-sort">Sort by price</label>
			<select id="catalog-sort" disabled>
				<option value="featured">Featured order</option>
				<option value="price-asc">Price: low to high</option>
				<option value="price-desc" selected>Price: high to low</option>
			</select>
		</div>
	</div>

	<p id="catalog-status" class="mt-4 text-sm text-gray-600" role="status">Loading the key catalog...</p>
	<noscript><p class="mt-4 text-sm text-gray-700">Enable JavaScript to browse the keys and build your quote.</p></noscript>
	<div id="catalog-scroll" class:list={["mt-3 overflow-y-auto rounded-3xl border border-slate-200 bg-gradient-to-br from-slate-100 via-sky-50 to-gray-100 p-3 pr-2", scrollClass]}>
		<div id="catalog-loading" class="grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 xxxl:grid-cols-5" aria-hidden="true">
			{Array.from({ length: 10 }, () => (
				<div class="h-80 rounded-2xl border border-gray-200 bg-white p-3">
					<div class="h-36 rounded-xl bg-slate-100"></div>
					<div class="mt-4 h-3 w-2/3 rounded bg-slate-100"></div>
					<div class="mt-3 h-3 rounded bg-slate-100"></div>
					<div class="mt-6 h-10 rounded-xl bg-slate-100"></div>
				</div>
			))}
		</div>
		<div id="catalog-error" class="hidden rounded-2xl bg-white p-6 text-center" role="alert">
			<p>The key catalog could not be loaded. Your saved quote cart is still available.</p>
			<button id="catalog-retry" type="button" class="button button-black mt-4 rounded-full px-5">Try again</button>
		</div>
		<div id="catalog-card-grid" class="grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 xxxl:grid-cols-5" aria-busy="true"></div>
		<p id="catalog-empty" class="hidden rounded-2xl bg-white p-6 text-center text-gray-700">No keys match your filters. Try a different make, key type, or search.</p>
		<div id="catalog-sentinel" class="hidden py-4 text-center text-sm text-gray-600" aria-hidden="true"></div>
	</div>

	<!-- Clone one card only when needed; no product data or hundreds of cards in the page response. -->
	<template id="catalog-card-template">
		<article class="flex h-full flex-col rounded-2xl border border-gray-200 bg-white p-3 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
			<KeyProductImage alt="Car key" label="Key" />
			<div class="mt-3 flex flex-1 flex-col">
				<div class="flex items-start justify-between gap-2">
					<p data-catalog-make class="min-w-0 text-[11px] font-bold uppercase tracking-[0.12em] text-sky-700"></p>
					<p data-catalog-sku class="shrink-0 rounded-full bg-gray-200 px-2 py-0.5 text-[10px] font-bold uppercase tracking-[0.06em] text-gray-700"></p>
				</div>
				<h6 data-catalog-description class="mt-2 text-xs font-semibold leading-snug text-gray-950"></h6>
				<div class="mt-auto grid grid-cols-1 gap-1.5 pt-3">
					{[
						["excellent", "No scratches"],
						["light-scratches", "Light scratches"],
						["worn", "Worn"],
					].map(([condition, label]) => (
						<button type="button" data-select-condition={condition} aria-pressed="false" class="group flex min-h-10 items-center justify-between gap-2 rounded-xl border border-gray-200 bg-gray-50 px-2.5 py-2 text-left transition hover:border-gray-900 hover:bg-gray-900 hover:text-white focus:border-gray-900 focus:bg-gray-900 focus:text-white focus:outline-none">
							<span class="min-w-0 text-[11px] font-semibold text-gray-500 transition group-hover:text-white group-focus:text-white">{label}</span>
							<span data-catalog-price class="shrink-0 text-sm font-bold text-gray-900 transition group-hover:text-white group-focus:text-white"></span>
						</button>
					))}
				</div>
			</div>
		</article>
	</template>
</section>

<script>
	import { mountPriceCatalog } from "~/lib/priceCatalogView";
	document.addEventListener("astro:page-load", () => {
		const section = document.getElementById("price-catalog");
		if (!(section instanceof HTMLElement) || section.dataset.initialized) return;
		section.dataset.initialized = "true";
		const cleanup = mountPriceCatalog(section);
		document.addEventListener("astro:before-swap", cleanup, { once: true });
	});
</script>
